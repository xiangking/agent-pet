{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Pet",
  "version": "0.1.0",
  "identifier": "com.xiangking.agentpet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "Agent Pet",
        "x": 120,
        "y": 120,
        "width": 240,
        "height": 186,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Agent Pet Settings",
        "width": 860,
        "height": 720,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://raw.githubusercontent.com https://codex-pets.net; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["pet", "settings"],
          "permissions": [
            "core:default",
            "core:window:allow-cursor-position",
            "core:window:allow-outer-position",
            "core:window:allow-scale-factor",
            "core:window:allow-set-ignore-cursor-events",
            "core:window:allow-start-dragging",
            "core:window:allow-set-size",
            "core:window:allow-set-position"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ]
  }
}
